#!/bin/bash
# Copyright (c) BDist Development Team
# Distributed under the terms of the Modified BSD License.
set -o errexit
set -o pipefail
if [ "${FLASK_ENV:-production}" = "production" ]; then
    exec gunicorn wsgi:app --bind 0.0.0.0:8080 --workers "${WEB_CONCURRENCY:-2}" --log-file -
else
    exec flask run --host=0.0.0.0 --port=8080
fi
