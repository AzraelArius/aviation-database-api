# Local development placeholders, never production credentials.
POSTGRES_DB=aviation
POSTGRES_USER=aviation_dev
POSTGRES_PASSWORD=local_only_aviation
POSTGRES_PORT=5432
HTTP_PORT=8080
WEB_CONCURRENCY=2
# Used by host commands; Compose supplies its own container connection settings.
DATABASE_URL=postgresql://aviation_dev:local_only_aviation@127.0.0.1:5432/aviation
